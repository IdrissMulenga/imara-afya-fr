# Copy to .env and fill in. .env is gitignored.

# WHICH PORT THE BACKEND LISTENS ON.
# This must match PORT in the backend's own .env. They were out of step once —
# the app called 4000 while the server was on 5500 — and every request failed
# looking exactly like a dead internet connection.
EXPO_PUBLIC_API_PORT=5500

# The full URL, when the host cannot be guessed from Metro.
# Leave BLANK in development: the app takes your computer's LAN address from
# the Metro host automatically, so a phone on the same wifi just works.
# REQUIRED in a production build, and it must be https there.
EXPO_PUBLIC_GRAPHQL_URL=
