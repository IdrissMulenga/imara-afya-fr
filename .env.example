# Copy this file to `.env` and fill in the values, then restart:  npx expo start -c
#
# EXPO_PUBLIC_* values are inlined into the app bundle at build time, so they
# are PUBLIC. Only put non-secret values here.

# --- Backend GraphQL endpoint (optional) ------------------------------------
# Leave blank to auto-detect your dev machine over LAN (port 5500).
# Set it for staging/production.
# EXPO_PUBLIC_GRAPHQL_URL=https://api.example.com/graphql

# --- Profile photos ---------------------------------------------------------
# No config needed. Avatars are downsized in the app (lib/image.ts) and stored
# inline on the user document. If you later move to a CDN (Cloudinary/S3),
# add its keys here and update lib/image.ts to upload + return the URL.
