# Copy to .env and fill in. .env is gitignored.
#
# Google Maps key for the Find care map on Android.
# Get it at https://console.cloud.google.com -> APIs & Services -> Credentials
# Enable "Maps SDK for Android", then restrict the key to:
#   Application restriction : Android apps
#   Package name            : bi.imaraco.imaraafya
#   SHA-1                   : from `eas credentials` (one per build profile)
GOOGLE_MAPS_API_KEY=

# Google Maps key for iOS. The app uses Google on both platforms so they match.
# This must be a SEPARATE key from the Android one — different Google product.
# Enable "Maps SDK for iOS", then restrict the key to:
#   Application restriction : iOS apps
#   Bundle ID               : bi.imaraco.imaraafya
# (no SHA-1 on iOS — that is Android only)
# If left blank, iOS falls back to Apple Maps and logs a warning.
GOOGLE_MAPS_IOS_API_KEY=
